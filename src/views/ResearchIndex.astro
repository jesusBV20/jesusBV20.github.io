---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import { content, label, type Lang } from "@/lib/content";
import { entries } from "@/lib/entries";
import { href } from "@/lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { publications } = content();
const topics = (await entries("research", lang)).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base lang={lang} nav="research" title={label("research.title", lang)}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-14 pb-6">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">{label("research.title", lang)}</h1>
    <p class="mt-3 text-muted max-w-2xl">{label("research.intro", lang)}</p>
  </section>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-6 grid gap-6 sm:grid-cols-2">
    {
      topics.map((t) => {
        const count = publications.filter((p) => p.topics.includes(t.slug)).length;
        return (
          <a
            href={href(lang, `/research/${t.slug}`)}
            class="group overflow-hidden rounded-2xl border border-line hover:border-accent/50 transition-colors"
          >
            {t.pictures[0] && (
              <Image
                src={t.pictures[0]}
                alt=""
                width={720}
                class="w-full aspect-[16/9] object-cover bg-surface border-b border-line group-hover:opacity-95"
              />
            )}
            <div class="p-5">
              <h2 class="text-lg font-semibold group-hover:text-accent">{t.data.title}</h2>
              <p class="mt-1.5 text-sm text-muted leading-relaxed">{t.data.summary}</p>
              <p class="mt-3 inline-flex items-center gap-1.5 text-xs text-subtle">
                <Icon name="pdf" class="size-3.5" />
                {count} {label("research.papers", lang).toLowerCase()}
                {t.data.videos.length > 0 && (
                  <>
                    <span>·</span>
                    <Icon name="video" class="size-3.5" />
                    {`${t.data.videos.length} ${label("research.videos", lang).toLowerCase()}`}
                  </>
                )}
              </p>
            </div>
          </a>
        );
      })
    }
  </section>
</Base>
