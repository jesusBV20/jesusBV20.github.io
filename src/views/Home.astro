---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import Text from "@/components/Text.astro";
import Publication from "@/components/Publication.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { content, label, tr, formatDate, byDateDesc, type Lang } from "@/lib/content";
import { entries } from "@/lib/entries";
import { href, asset } from "@/lib/i18n";
import { contentImage } from "@/lib/pictures";
import { excerpt } from "@/lib/excerpt";
import { pdfName } from "@/lib/cv-files";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { profile, publications, talks } = content();

const featured = publications.filter((p) => p.featured);
const topics = (await entries("research", lang)).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const news = (await entries("news", lang))
  .filter((n) => !n.data.draft)
  .sort(byDateDesc((n) => n.data.date.toISOString()))
  .slice(0, 4);
const recentTalks = [...talks].sort(byDateDesc((t) => t.date)).slice(0, 4);
const dateFmt = new Intl.DateTimeFormat(lang === "es" ? "es-ES" : "en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Base lang={lang} nav="home">
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-14 sm:pt-20 pb-12">
    <div class="grid gap-8 sm:gap-12 sm:grid-cols-[1fr_15rem] items-start">
      <div class="order-2 sm:order-1">
        <p class="text-sm font-medium text-accent">{tr(profile.role, lang)}</p>
        <h1 class="mt-2 text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.08]">{profile.name}</h1>
        <p class="mt-3 text-muted">{tr(profile.affiliation, lang)}</p>
        <p class="mt-1 text-sm text-subtle inline-flex items-center gap-1.5">
          <Icon name="pin" class="size-3.5" />
          {tr(profile.location, lang)}
        </p>
        <Text as="p" text={tr(profile.bio, lang)} class="mt-6 text-[1.05rem] leading-relaxed text-fg/90 max-w-2xl" />

        <div class="mt-7 flex flex-wrap items-center gap-2.5">
          <a
            href={asset(`cv/${pdfName(lang)}`)}
            class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-bg hover:opacity-90"
          >
            <Icon name="download" class="size-4" />
            {label("home.downloadCv", lang)}
          </a>
          <a
            href={`mailto:${profile.email}`}
            class="inline-flex items-center gap-2 rounded-lg border border-line px-4 py-2 text-sm font-medium hover:border-accent/50 hover:text-accent"
          >
            <Icon name="mail" class="size-4" />
            {profile.email}
          </a>
          <div class="flex items-center gap-1 ml-1">
            {
              profile.links.map((l) => (
                <a href={l.href} rel="me noopener" class="p-2 rounded-md text-muted hover:text-accent" title={l.network}>
                  <Icon name={l.network} class="size-5" title={l.network} />
                </a>
              ))
            }
          </div>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2" aria-label={label("home.interests", lang)}>
          {
            profile.interests.map((i) => (
              <li class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">{tr(i, lang)}</li>
            ))
          }
        </ul>
      </div>
      <div class="order-1 sm:order-2">
        <Image
          src={contentImage(profile.photo)}
          alt={profile.name}
          width={480}
          loading="eager"
          class="w-40 sm:w-full aspect-square object-cover rounded-2xl border border-line shadow-sm"
        />
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 border-t border-line">
    <SectionTitle title={label("nav.research", lang)} more={{ label: label("research.back", lang), href: href(lang, "/research") }} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        topics.map((t) => (
          <a
            href={href(lang, `/research/${t.slug}`)}
            class="group rounded-xl border border-line p-5 hover:border-accent/50 hover:bg-surface transition-colors"
          >
            <h3 class="font-semibold group-hover:text-accent">{t.data.title}</h3>
            <p class="mt-1.5 text-sm text-muted leading-relaxed">{t.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Selected publications -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 border-t border-line">
    <SectionTitle
      title={label("home.featured", lang)}
      more={{ label: label("home.allPublications", lang), href: href(lang, "/publications") }}
    />
    <div class="space-y-8">
      {featured.map((p) => <Publication pub={p} lang={lang} />)}
    </div>
  </section>

  <!-- News + talks -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-12 border-t border-line grid gap-12 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <SectionTitle title={label("home.news", lang)} more={{ label: label("home.allNews", lang), href: href(lang, "/news") }} />
      <ul class="space-y-6">
        {
          news.map((n) => (
            <li>
              <a href={href(lang, `/news/${n.slug}`)} class="group block">
                <time class="text-xs text-subtle" datetime={n.data.date.toISOString()}>
                  {dateFmt.format(n.data.date)}
                </time>
                <h3 class="mt-0.5 font-semibold group-hover:text-accent">{n.data.title}</h3>
                <p class="mt-1 text-sm text-muted line-clamp-2">{n.data.summary ?? excerpt(n.entry.body ?? "")}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <SectionTitle title={label("home.talks", lang)} />
      <ol class="relative border-l border-line ml-1.5 space-y-6">
        {
          recentTalks.map((t) => (
            <li class="pl-5 relative">
              <span class="absolute -left-[5px] top-1.5 size-2.5 rounded-full bg-accent" />
              <p class="text-xs text-subtle">
                {formatDate(t.date, lang)} · {label(`talk.${t.kind}`, lang)}
              </p>
              <p class="mt-0.5 text-sm font-medium leading-snug">{t.title}</p>
              <p class="text-sm text-muted">
                {t.event}
                {t.location && <span class="text-subtle"> · {tr(t.location, lang)}</span>}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
