---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import { label, byDateDesc, type Lang } from "@/lib/content";
import { entries } from "@/lib/entries";
import { href } from "@/lib/i18n";
import { excerpt } from "@/lib/excerpt";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const posts = (await entries("news", lang)).filter((n) => !n.data.draft).sort(byDateDesc((n) => n.data.date.toISOString()));
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const dateFmt = new Intl.DateTimeFormat(lang === "es" ? "es-ES" : "en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
---

<Base lang={lang} nav="news" title={label("news.title", lang)}>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 pt-14 pb-2">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">{label("news.title", lang)}</h1>
    <p class="mt-3 text-muted">{label("news.intro", lang)}</p>
  </section>
  <section class="mx-auto max-w-4xl px-4 sm:px-6">
    {
      years.map((y) => (
        <div class="pt-10">
          <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-subtle mb-4 pb-2 border-b border-line">{y}</h2>
          <ul class="divide-y divide-line">
            {posts
              .filter((p) => p.data.date.getUTCFullYear() === y)
              .map((p) => (
                <li>
                  <a href={href(lang, `/news/${p.slug}`)} class="group grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5.5rem_1fr_8rem] gap-4 py-5 items-start">
                    <time class="text-sm text-subtle pt-0.5" datetime={p.data.date.toISOString()}>
                      {dateFmt.format(p.data.date)}
                    </time>
                    <div class="min-w-0">
                      <h3 class="font-semibold group-hover:text-accent">{p.data.title}</h3>
                      <p class="mt-1 text-sm text-muted line-clamp-2">{p.data.summary ?? excerpt(p.entry.body ?? "")}</p>
                      {p.data.videos.length > 0 && (
                        <p class="mt-2 inline-flex items-center gap-1 text-xs text-subtle">
                          <Icon name="video" class="size-3.5" /> {label("research.videos", lang)}
                        </p>
                      )}
                    </div>
                    <div class="hidden sm:block">
                      {p.pictures[0] ? (
                        <Image src={p.pictures[0]} alt="" width={256} class="w-full aspect-[4/3] object-cover rounded-lg border border-line" />
                      ) : p.data.videos[0] ? (
                        <img
                          src={`https://i.ytimg.com/vi/${p.data.videos[0]}/mqdefault.jpg`}
                          alt=""
                          loading="lazy"
                          class="w-full aspect-[4/3] object-cover rounded-lg border border-line"
                        />
                      ) : null}
                    </div>
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>
