---
import View from "@/views/ResearchTopic.astro";
import { entries } from "@/lib/entries";

export async function getStaticPaths() {
  return (await entries("research", "en")).map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}
const { topic } = Astro.props;
---

<View lang="en" topic={topic} />
