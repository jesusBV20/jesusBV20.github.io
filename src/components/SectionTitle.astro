---
import Icon from "./Icon.astro";
interface Props {
  title: string;
  more?: { label: string; href: string };
}
const { title, more } = Astro.props;
---

<div class="flex items-baseline justify-between gap-4 mb-6">
  <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-subtle">{title}</h2>
  {
    more && (
      <a href={more.href} class="inline-flex items-center gap-1 text-sm text-muted hover:text-accent">
        {more.label}
        <Icon name="arrow" class="size-3.5" />
      </a>
    )
  }
</div>
