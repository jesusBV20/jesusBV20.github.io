---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { content, label, type Lang, type Publication } from "@/lib/content";
import { contentImage } from "@/lib/pictures";

interface Props {
  pub: Publication;
  lang: Lang;
  /** Hide the thumbnail (front page, CV-like lists). */
  compact?: boolean;
}
const { pub, lang, compact = false } = Astro.props;
const { profile } = content();

// Built as one string: JSX whitespace between mapped spans would put a space before each comma.
const escape = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const authorsHtml = pub.authors
  .split(/,\s*/)
  .map((name) =>
    profile.authorNames.includes(name)
      ? `<span class="text-fg font-medium underline decoration-accent/40 underline-offset-2">${escape(name)}</span>`
      : escape(name),
  )
  .join(", ");

const isDoi = pub.doi && /doi\.org\/10\./.test(pub.doi);
const buttons = [
  ...(pub.pdf ? [{ label: "PDF", href: pub.pdf, icon: "pdf" }] : []),
  ...(pub.doi ? [{ label: isDoi ? "DOI" : label("pubs.publisher", lang), href: pub.doi, icon: "link" }] : []),
  ...pub.links.map((l) => ({
    label: l.label,
    href: l.href,
    icon: /video|youtube/i.test(l.label + l.href) ? "video" : /code|github/i.test(l.label + l.href) ? "code" : "link",
  })),
];
---

<article class="group grid gap-x-5 gap-y-3" class:list={[!compact && pub.image ? "sm:grid-cols-[9.5rem_1fr]" : ""]} id={pub.slug}>
  {
    !compact && pub.image && (
      <div class="hidden sm:block">
        <Image
          src={contentImage(pub.image)}
          alt={pub.imageAlt ?? ""}
          width={320}
          class="w-full aspect-[4/3] object-cover rounded-lg border border-line bg-surface"
        />
      </div>
    )
  }
  <div class="min-w-0">
    <h3 class="font-semibold leading-snug text-[1.02rem] text-fg">
      {pub.pdf || pub.doi ? <a href={pub.pdf ?? pub.doi} class="hover:text-accent">{pub.title}</a> : pub.title}
    </h3>
    <p class="mt-1 text-sm text-muted" set:html={authorsHtml} />
    <p class="mt-0.5 text-sm">
      <span class="italic text-fg/85">{pub.venue}</span>
      <span class="text-subtle"> · {pub.year}</span>
    </p>
    {pub.note && <p class="mt-1 text-sm text-accent font-medium">{pub.note}</p>}
    <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
      {
        buttons.map((b) => (
          <a
            href={b.href}
            rel="noopener"
            class="inline-flex items-center gap-1.5 rounded-md border border-line px-2 py-0.5 text-xs font-medium text-muted hover:text-accent hover:border-accent/50 transition-colors"
          >
            <Icon name={b.icon} class="size-3.5" />
            {b.label}
          </a>
        ))
      }
      {
        pub.abstract && (
          <button
            type="button"
            data-abstract-toggle
            aria-expanded="false"
            aria-controls={`abs-${pub.slug}`}
            class="inline-flex items-center gap-1.5 rounded-md border border-line px-2 py-0.5 text-xs font-medium text-muted hover:text-accent hover:border-accent/50 aria-expanded:text-accent aria-expanded:border-accent/50"
          >
            <Icon name="quote" class="size-3.5" />
            {label("pubs.abstract", lang)}
          </button>
        )
      }
    </div>
    {
      pub.abstract && (
        <p id={`abs-${pub.slug}`} hidden class="mt-3 text-sm leading-relaxed text-muted border-l-2 border-line pl-3">
          {pub.abstract}
        </p>
      )
    }
  </div>
</article>

<script>
  // One listener for every abstract button on the page.
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-abstract-toggle]");
    if (!button) return;
    const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
    if (!panel) return;
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    panel.hidden = open;
  });
</script>
